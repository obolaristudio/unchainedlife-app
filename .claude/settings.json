{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pip install:*)",
      "Bash(yt-dlp:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(rm:*)",
      "Bash(cat:*)",
      "mcp__ElevenLabs",
      "mcp__composio",
      "mcp__gpt_social",
      "mcp__claude-code-remote__send_later",
      "SendUserFile",
      "Artifact",
      "Bash(npx hyperframes@0.9.19:*)",
      "Bash(npx -y hyperframes@0.9.19:*)"
    ]
  },
  "env": {
    "HYPERFRAMES_NO_TELEMETRY": "1",
    "DO_NOT_TRACK": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}