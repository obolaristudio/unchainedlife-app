# Copie para .env e preencha:  cp .env.example .env
# NUNCA envie o .env para ninguém nem para o GitHub.

# Endereço PÚBLICO da carteira do bot (0x...), a que tem o USDC depositado
HL_ACCOUNT_ADDRESS=0x...

# Chave privada da API WALLET (gerada em app.hyperliquid.xyz/API). Ela opera, mas NÃO saca.
HL_API_SECRET=

# true = só simula (comece assim). false = envia ordens reais.
DRY_RUN=true
HL_TESTNET=false

COIN=BTC
INTERVAL=4h
MAX_LEVERAGE=3
RISK_PER_TRADE=0.02
DAILY_LOSS_LIMIT=0.05
